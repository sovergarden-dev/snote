{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.tsx!",
    "tailwind.config.ts!",
    "e2e-extension/playwright.config.ts",
    "playwright.realtime.config.ts",
    "e2e-extension/**/*.spec.ts",
    "cloudflare-worker/worker.js!",
    "public/sw-kill.js!",
    "chrome-extension/background.js!",
    "chrome-extension/options.js!",
    "chrome-extension/sidepanel.js!",
    "supabase/functions/*/index.ts!",
    "src/lib/realtime/hub/node-adapter.ts!",
    "src/lib/realtime/hub/durable-object-worker.ts!",
    "supabase/functions/old-slug-cleanup-status/index.test.ts",
    "scripts/build-extension-zip.ts",
    "scripts/check-bundle-size.ts",
    "scripts/check-home-theme-isolation.ts",
    "scripts/extension-archive.ts",
    "scripts/i18n-allowlist-check.ts",
    "scripts/i18n-audit.ts",
    "scripts/i18n-coverage.ts",
    "scripts/verify-capability-cutover.ts",
    "scripts/verify-extension-zip.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}!",
    "!src/**/__tests__/**!",
    "!src/**/*.{test,spec}.{ts,tsx}!",
    "!src/test/**!",
    "!src/i18n/catalog.ts!",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "e2e-extension/**/*.ts",
    "chrome-extension/**/*.{js,ts}!",
    "cloudflare-worker/**/*.js!",
    "supabase/functions/**/*.ts!",
    "*.{config.ts,config.js}"
  ],
  "ignore": [
    "src/integrations/supabase/types.ts",
    "src/lib/yjs/local-convert-provider.ts",
    "src/lib/realtime/hub/cloudflare-workers.d.ts",
    "src/lib/realtime/hub/__tests__/bun-sqlite.d.ts"
  ],
  "ignoreDependencies": [
    "@vitest/coverage-v8",
    "cloudflare",
    "turndown-plugin-gfm"
  ]
}

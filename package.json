  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:release": "bun run scripts/build-release.ts",
    "build:check": "vite build && bun run scripts/check-bundle-size.ts",
    "build:dev": "vite build --mode development",
    "lint": "eslint . --max-warnings 0",
    "knip": "knip --include files,dependencies,unlisted,unresolved --no-config-hints && knip --production --include files,dependencies,unlisted,unresolved --no-config-hints",

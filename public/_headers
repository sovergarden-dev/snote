# Cloudflare Pages applies these rules on direct requests to the pages.dev origin.
# Requests to note.syrin.online pass through the syrin-prerender Worker, which
# sets or overwrites the production CSP, Permissions-Policy, nosniff, and /s/*
# private/no-store policy. HSTS on note.syrin.online comes from the zone's
# Transform Rule; vercel.json is not on the production request path.
#
# Lighthouse Speed report: "Use efficient cache lifetimes" (~754 KiB savings).
# Vite's hashed asset filenames (e.g. index-BHPmQ4m1.js) are content-addressed
# and never overwritten, so they're safe to mark immutable for a year.
# index.html itself must NOT be cached, otherwise users would never see new
# deploys until forcing a refresh. The service worker, its loader, the web
# manifest, and the version.json heartbeat must also stay no-cache so update
# detection works on every reload.


/*
  Content-Security-Policy: frame-ancestors 'self' chrome-extension://*

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/s
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

/s/*
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/registerSW.js
  Cache-Control: no-cache, no-store, must-revalidate

/workbox-*.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate

/version.json
  Cache-Control: no-cache, no-store, must-revalidate
